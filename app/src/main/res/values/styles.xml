<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="SplashTheme" parent="Theme.MyApp">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- FEAT-23 (nhân tiện): dành riêng cho nút NẰM TRONG pill bo 28dp (bg_floating_pill) —
         bo nhỏ hơn corner cha nhưng lớn hơn 8dp mặc định, tránh 2 lớp bo góc lệch nhau. -->
    <style name="ShapeAppearance.App.PillInner" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Bo góc CHỈ cạnh trái — dùng cho nút ĐẦU trong MaterialButtonToggleGroup. Tự set cứng cạnh
         phải = 0dp thay vì trông cậy cơ chế tự "cắt phẳng cạnh trong" của ToggleGroup — cơ chế đó
         render sai (cả 2 cạnh đều bo) khi nút dùng shapeAppearance tuỳ biến + strokeColor riêng. -->
    <style name="ShapeAppearance.App.PillInner.Start" parent="ShapeAppearance.App.PillInner">
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Bo góc CHỈ cạnh phải — dùng cho nút CUỐI trong MaterialButtonToggleGroup. -->
    <style name="ShapeAppearance.App.PillInner.End" parent="ShapeAppearance.App.PillInner">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.App.FloatActionButton" parent="ShapeAppearanceOverlay.Material3.FloatingActionButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Material3.Button.FilledButton" parent="Widget.Material3.Button" />

    <style name="WindowAnimationTransition" parent="Animation.Material3.BottomSheetDialog">
        <item name="android:activityOpenEnterAnimation">@anim/a_open_in</item>
        <item name="android:activityOpenExitAnimation">@anim/a_open_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/a_close_in</item>
        <item name="android:activityCloseExitAnimation">@anim/a_close_out</item>
    </style>

    <style name="Theme.MyApp.TitleText" parent="MaterialAlertDialog.Material3.Title.Text" />

    <style name="MySeekBarStyle" parent="Widget.Material3.Slider">
        <item name="android:maxHeight">20dp</item>
        <item name="android:height">20dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="thumbRadius">10dp</item>
        <item name="thumbStrokeColor">@android:color/transparent</item>
        <item name="tickColor">@android:color/transparent</item>
        <item name="trackHeight">4dp</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="ProgressBarStyle">
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>

    <style name="AboutPageTextViewStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:drawableTint">?attr/colorOnSurface</item>
    </style>

    <style name="SaveDialogTextViewStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="SaveDialogExposedDropdownMenu" parent="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SaveDialogAutoCompleteTextView">
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="BottomSheetDialog.App" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="MaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text" />

    <style name="BottomSheetDialog.App.Button" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ThemeOverlay.App.FloatingActionButton" parent="ThemeOverlay.Material3.FloatingActionButton.Primary">
        <item name="colorContainer">?attr/colorPrimaryContainer</item>
        <item name="colorOnContainer">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button</item>
    </style>

    <style name="Widget.App.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.TextButton</item>
    </style>

    <style name="Widget.App.AlertDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.TextButton</item>
    </style>

    <!-- Audit M3 (typography) 2026-09-23: gom size/color/weight TextView lặp lại >=2 lần trên
         toàn app thành TextAppearance.App.* dùng chung — đổi type scale sau này chỉ sửa 1 chỗ
         thay vì rải rác nhiều layout. Không đổi giá trị hiện tại (chỉ tái cấu trúc). -->
    <style name="TextAppearance.App.Body16" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Body15" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Body15Bold" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Body14" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Body14Variant" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Body13" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Body13Variant" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Body13Selector" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/selector_toggle_button_text</item>
    </style>

    <style name="TextAppearance.App.Label12Variant" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.Label12Bold" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Label11VariantBold" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Label11PrimaryBold" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title22Bold" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title20Bold" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title18Bold" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title16Bold" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Label16OnPrimaryBold" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Label16OnPrimaryMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
