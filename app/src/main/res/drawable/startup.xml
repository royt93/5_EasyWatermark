<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- M3 Solid Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_window_bg" />
        </shape>
    </item>

    <!-- Logo with Circle Background -->
    <item
        android:width="220sp"
        android:height="220sp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/splash_circle_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/splash_circle_border" />
        </shape>
    </item>

    <!-- Logo Icon -->
    <item
        android:width="180sp"
        android:height="180sp"
        android:drawable="@drawable/ic_launcher_960"
        android:gravity="center"
        tools:ignore="UnusedAttribute" />
</layer-list>
