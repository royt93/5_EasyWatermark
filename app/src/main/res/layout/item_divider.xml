<?xml version="1.0" encoding="utf-8"?>
<!-- item_divider — vạch ngăn mảnh giữa các nhóm chip trong rvColor.
     marginStart/End 4dp để khoảng cách chip→divider = 4(margin chip)+4(margin divider) = 8dp,
     bằng đúng khoảng cách chip→chip (4dp+4dp) — tránh spacing không đều quanh divider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="1dp"
    android:layout_height="56dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorOutlineVariant" />

</FrameLayout>
