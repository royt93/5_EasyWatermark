<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/signature_history_item"
    android:background="@drawable/bg_panel_outlined">

    <ImageView
        android:id="@+id/ivSignature"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/ivDeleteBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:padding="4dp"
        android:background="@drawable/bg_circle_red"
        android:src="@drawable/ic_remove_item"
        android:contentDescription="@string/signature_history_delete"
        app:tint="@android:color/white" />

</FrameLayout>
