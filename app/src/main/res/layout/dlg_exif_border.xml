<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_gradient_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:id="@+id/vHandle"
        android:layout_width="45dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#2E2E2E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_button">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_func_layout_vertical"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leica_exif_border"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/leica_exif_border_desc"
                    android:textSize="13sp"
                    android:textColor="#A0A0A0" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swExif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:thumbTint="@null"
                app:trackTint="@null"
                app:switchMinWidth="50dp"
                android:background="@null"
                android:thumb="@drawable/bg_ios_switch_thumb"
                app:track="@drawable/bg_ios_switch_track" />

        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/groupFrameStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/exif_frame_style_label"
            android:textColor="#A0A0A0"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleClassic"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/glass_overlay_medium"
                    android:text="@string/exif_frame_style_classic"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="45dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStylePolaroid"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/glass_overlay_medium"
                    android:text="@string/exif_frame_style_polaroid"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="45dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleFilmStrip"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/glass_overlay_medium"
                    android:text="@string/exif_frame_style_film_strip"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="45dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleMinimal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/glass_overlay_medium"
                    android:text="@string/exif_frame_style_minimal"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="45dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- ══ FEAT-14: Custom Frame Builder — tham số hoá 4 style sẵn có ══════════ -->
    <LinearLayout
        android:id="@+id/groupCustomize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_label"
                android:textColor="#A0A0A0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvExifCustomizeReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/exif_customize_reset"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_band_color"
                android:textColor="@color/glass_text_primary"
                android:textSize="14sp" />

            <View
                android:id="@+id/vExifBandColorSwatch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_color_swatch" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_band_thickness"
                android:textColor="@color/glass_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvExifBandThicknessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/glass_text_secondary"
                android:textSize="13sp"
                tools:text="12%" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slideExifBandThickness"
            style="@style/MySeekBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:stepSize="1"
            android:valueFrom="4"
            android:valueTo="30"
            tools:value="12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_serif_caption"
                android:textColor="@color/glass_text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swExifSerifCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@null"
                app:trackTint="@null"
                app:switchMinWidth="50dp"
                android:background="@null"
                android:thumb="@drawable/bg_ios_switch_thumb"
                app:track="@drawable/bg_ios_switch_track" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
