<?xml version="1.0" encoding="utf-8"?>
<!-- BUG-18 re-audit: nội dung khi bật "Leica EXIF Border" (Frame Style + Customize + Serif
     caption) có thể cao hơn chiều cao khả dụng của màn hình — trước đây root là LinearLayout
     wrap_content trực tiếp nên phần cuối (switch Serif caption) bị nav bar 3 nút che mất, không
     kéo/chạm được (xác nhận bằng uiautomator: bounds switch đó nằm ngoài vùng an toàn của cửa sổ
     app). Bọc trong NestedScrollView (đúng pattern chuẩn cho nội dung BottomSheetDialogFragment
     có thể vượt màn hình) để phần cuối luôn kéo lên xem/chạm được, kể cả trên thiết bị nav bar to. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:id="@+id/vHandle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        android:background="@drawable/bg_m3_drag_handle" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_selectable">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_func_frame"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leica_exif_border"
                    android:textAppearance="@style/TextAppearance.App.Title18Bold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/leica_exif_border_desc"
                    android:textAppearance="@style/TextAppearance.App.Body13Variant" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swExif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/leica_exif_border"
                android:layout_marginStart="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/groupFrameStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/exif_frame_style_label"
            android:textAppearance="@style/TextAppearance.App.Body13Variant" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleClassic"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:text="@string/exif_frame_style_classic"
                    android:textAppearance="@style/TextAppearance.App.Body13"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStylePolaroid"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:text="@string/exif_frame_style_polaroid"
                    android:textAppearance="@style/TextAppearance.App.Body13"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleFilmStrip"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:text="@string/exif_frame_style_film_strip"
                    android:textAppearance="@style/TextAppearance.App.Body13"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleMinimal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:text="@string/exif_frame_style_minimal"
                    android:textAppearance="@style/TextAppearance.App.Body13"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- ══ FEAT-14: Custom Frame Builder — tham số hoá 4 style sẵn có ══════════ -->
    <LinearLayout
        android:id="@+id/groupCustomize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_label"
                android:textAppearance="@style/TextAppearance.App.Body13Variant" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExifCustomizeReset"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/exif_customize_reset"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_band_color"
                android:textAppearance="@style/TextAppearance.App.Body14" />

            <FrameLayout
                android:id="@+id/flExifBandColor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/exif_customize_band_color"
                android:background="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/vExifBandColorSwatch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_color_swatch" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_band_thickness"
                android:textAppearance="@style/TextAppearance.App.Body14" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExifBandThicknessValue"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Body13Variant"
                tools:text="12%" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slideExifBandThickness"
            style="@style/MySeekBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/exif_customize_band_thickness"
            android:focusable="true"
            android:stepSize="1"
            android:valueFrom="4"
            android:valueTo="30"
            tools:value="12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exif_customize_serif_caption"
                android:textAppearance="@style/TextAppearance.App.Body14" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swExifSerifCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/exif_customize_serif_caption" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
