<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Liquid Glass: item_saving_image — export progress thumbnail -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.mckimquyen.watermark.ui.widget.ProgressImageView
        android:id="@+id/ivIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_picker_image" />

    <ImageView
        android:id="@+id/ivDone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/action_save"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_save_done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FEAT-17: toggle skip/active — góc trên-phải, không đè lên ivDone (giữa) hay tvPreviewInfo (dưới). -->
    <ImageView
        android:id="@+id/ivSkipToggle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_preview_badge"
        android:contentDescription="@string/action_toggle_skip_export"
        android:padding="4dp"
        android:src="@drawable/baseline_check_circle_outline_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FEAT-07: ước tính kích thước/dung lượng output — chỉ hiện khi preview đã render xong. -->
    <TextView
        android:id="@+id/tvPreviewInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_preview_badge"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingVertical="3dp"
        android:paddingHorizontal="6dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1080×1350 · ~180 KB"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
