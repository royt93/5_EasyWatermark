<?xml version="1.0" encoding="utf-8"?>
<!--
    f_tile_mode — Repeat/Single toggle (Style tab)
    Dark frosted pill, radio buttons with white text
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_floating_pill"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <RadioGroup
        android:id="@+id/rgTileMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbTileModeRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="@string/tile_mode_title_repeat"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbTileModeDecal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="@string/tile_mode_title_decal"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp" />

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
