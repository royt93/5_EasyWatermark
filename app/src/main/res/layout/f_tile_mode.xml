<?xml version="1.0" encoding="utf-8"?>
<!--
    f_tile_mode — Repeat/Single toggle (Style tab)
    Pill nền M3 chuẩn (bg_floating_pill: ?attr/colorSurfaceContainerHigh, bo 28dp).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_floating_pill"
    android:clipToOutline="true"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgTileMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/vDividerAnchor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTileModeRepeat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/tile_mode_title_repeat"
            android:textAppearance="@style/TextAppearance.App.Body13Selector"
            app:backgroundTint="@color/selector_toggle_button_bg"
            app:shapeAppearance="@style/ShapeAppearance.App.PillInner.Start"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTileModeDecal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/tile_mode_title_decal"
            android:textAppearance="@style/TextAppearance.App.Body13Selector"
            app:backgroundTint="@color/selector_toggle_button_bg"
            app:shapeAppearance="@style/ShapeAppearance.App.PillInner.End"
            app:strokeWidth="0dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Tách trực quan: đây là action mở bottom sheet Vị trí, KHÔNG phải lựa chọn thứ 3
         cùng nhóm với Lặp lại/Đơn lẻ. -->
    <View
        android:id="@+id/vDividerAnchor"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPositionAnchor"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPositionAnchor"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginEnd="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/position_anchor_button"
        app:icon="@drawable/ic_anchor_center"
        app:iconSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
