<?xml version="1.0" encoding="utf-8"?>
<!--
    dlg_edit_text — Watermark text input sheet
    Dark frosted glass panel, white text on edit field
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glassmorphism_panel"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Handle -->
    <View
        android:id="@+id/vHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:alpha="0.4"
        android:background="@color/glass_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/dialog_title_edit_watermark"
        android:textColor="@color/glass_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnGoTemplate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vHandle" />

    <!-- Template shortcut icon -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoTemplate"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:icon="@drawable/ic_go_template_list"
        app:iconTint="@color/glass_text_primary"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle" />

    <!-- Token quick-insert row: {filename} {date} {seq}... -->
    <HorizontalScrollView
        android:id="@+id/hsvTokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true" />

    </HorizontalScrollView>

    <!-- Text input field: semi-transparent, white text -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlWaterText"
        style="@style/TextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint=""
        android:minHeight="130dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:boxBackgroundColor="#80000000"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/glass_border"
        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsvTokens"
        app:layout_constraintVertical_bias="0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWaterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeActionLabel="@string/tips_ok"
            android:imeOptions="actionDone"
            android:scrollbars="vertical"
            android:textColor="@color/glass_text_primary"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- CTA: white pill, dark text -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/glass_cta_bg"
        android:text="@string/tips_ok"
        android:textAllCaps="false"
        android:textColor="@color/glass_cta_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="45dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tlWaterText"
        app:strokeWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
