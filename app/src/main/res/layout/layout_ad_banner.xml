<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Liquid Glass: layout_ad_banner — frosted ad label + banner slot -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <!-- "Ad" pill label -->
    <TextView
        android:id="@+id/tvLabelAd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_glass_button"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text="Ad"
        android:textColor="@color/glass_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Banner slot -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        tools:background="@color/glass_surface"
        tools:layout_height="56dp" />

</LinearLayout>
