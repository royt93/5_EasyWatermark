<?xml version="1.0" encoding="utf-8"?>
<!--
    dlg_save_file — Export / Save Bottom Sheet
    Material Design 3 (Material You):
    - Background: ?attr/colorSurfaceContainerLow
    - Section labels: 11sp uppercase onSurfaceVariant
    - Cards: MaterialCardView rounded 16dp (?attr/colorSurfaceContainer)
    - 8dp gap between items within a group
    - 16dp gap between section groups
    - 24dp gap before primary CTA
    - CTA btn: FilledButton (?attr/colorPrimary)
    - Secondary: TextButton (?attr/colorPrimary)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/llContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Material 3 Handle pill -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.4"
        android:background="?attr/colorOnSurfaceVariant" />

    <!-- ══ SHEET TITLE ══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/dialog_export_to_gallery"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Export to Album" />

    <!-- ══ SECTION: FORMAT ══════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.1"
        android:text="@string/about_title_output"
        android:textAllCaps="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Format dropdown card -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuFormat"
        style="@style/SaveDialogExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/dialog_save_config_format"
        app:boxStrokeColor="?attr/colorOutline"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/atvFormat"
            style="@style/SaveDialogAutoCompleteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/dialog_save_config_format"
            android:inputType="none"
            android:labelFor="@id/menuFormat"
            android:minWidth="120dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══ SECTION: RESIZE (long edge) ══════════════════════════════════════ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuResize"
        style="@style/SaveDialogExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/dialog_save_config_resize"
        app:boxStrokeColor="?attr/colorOutline"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/atvResize"
            style="@style/SaveDialogAutoCompleteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/dialog_save_config_resize"
            android:inputType="none"
            android:labelFor="@id/menuResize"
            android:minWidth="120dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══ SECTION: FILE NAME PATTERN ═══════════════════════════════════════ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilOutputName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/dialog_save_config_name_pattern"
        app:boxStrokeColor="?attr/colorOutline"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:placeholderText="@string/dialog_save_config_name_pattern_hint"
        app:placeholderTextColor="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOutputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══ SECTION: COPYRIGHT (EXIF) ════════════════════════════════════════ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCopyright"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/dialog_save_config_copyright"
        app:boxStrokeColor="?attr/colorOutline"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:placeholderText="@string/dialog_save_config_copyright_hint"
        app:placeholderTextColor="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textShortMessage"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══ SECTION: QUALITY ═════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/flQuality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/dialog_save_config_quality"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQualityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="80" />

    </FrameLayout>

    <!-- Slider in MaterialCardView -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <com.google.android.material.slider.Slider
            android:id="@+id/slideQuality"
            style="@style/MySeekBarStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:focusable="false"
            android:stepSize="20"
            android:valueFrom="20.0"
            android:valueTo="100.0"
            app:labelBehavior="floating"
            tools:value="80" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ══ FEAT-13: entry point cho caption riêng từng ảnh ═════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBatchCaptions"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:text="@string/batch_caption_entry"
        android:textColor="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_edit"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorPrimary" />

    <!-- ══ SECTION: EXPORT LIST ═════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="EXPORT LIST 0/3" />

    <!-- Image preview grid -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResult"
            android:layout_width="match_parent"
            android:layout_height="@dimen/save_result_row_height"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="none" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ══ PRIMARY CTA: Material You FilledButton ════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:backgroundTint="?attr/colorPrimary"
        android:fontFamily="sans-serif-medium"
        android:text="@string/dialog_export_to_gallery"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="2dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnPrimary"
        app:rippleColor="?attr/colorOnPrimary"
        app:strokeWidth="0dp" />

    <!-- ══ SECONDARY: Open in gallery ══════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenGallery"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_picker_image"
        app:iconGravity="textStart"
        android:text="@string/dialog_open_in_gallery"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
