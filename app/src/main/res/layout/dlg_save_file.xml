<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Glass gradient background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_gradient" />

    <LinearLayout
        android:id="@+id/llContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        tools:ignore="UselessParent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOutputFormat"
            style="@style/SaveDialogTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center|start"
            android:includeFontPadding="false"
            android:text="@string/about_title_output"
            android:textColor="@color/glass_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/menuFormat"
            style="@style/SaveDialogExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:hint="@string/dialog_save_config_format"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="@color/glass_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/atvFormat"
                style="@style/SaveDialogAutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dialog_save_config_format"
                android:inputType="none"
                android:labelFor="@id/menuFormat"
                android:minWidth="120dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/glass_text_primary"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:id="@+id/flQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQuality"
                style="@style/SaveDialogTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:text="@string/dialog_save_config_quality"
                android:textColor="@color/glass_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvQualityValue"
                style="@style/SaveDialogTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|end"
                android:includeFontPadding="false"
                android:textColor="@color/glass_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="80" />
        </FrameLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slideQuality"
            style="@style/MySeekBarStyle"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:focusable="false"
            android:stepSize="20"
            android:valueFrom="20.0"
            android:valueTo="100.0"
            app:labelBehavior="floating"
            tools:value="25" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvResult"
            style="@style/SaveDialogTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:includeFontPadding="false"
            android:paddingTop="30dp"
            android:text="@string/dialog_save_export_list_title"
            android:textColor="@color/glass_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResult"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:scrollbars="vertical" />

        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="43dp"
            android:backgroundTint="@color/glass_overlay_strong"
            android:elevation="8dp"
            android:gravity="center"
            android:text="@string/dialog_export_to_gallery"
            android:textAlignment="center"
            android:textColor="@color/glass_text_primary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenGallery"
            style="@style/Widget.App.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@android:color/transparent"
            android:gravity="center"
            android:text="@string/dialog_open_in_gallery"
            android:textAlignment="center"
            android:textColor="@color/glass_text_secondary" />
    </LinearLayout>
</FrameLayout>
