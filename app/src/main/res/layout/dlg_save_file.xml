<?xml version="1.0" encoding="utf-8"?>
<!--
    dlg_save_file — Export / Save Bottom Sheet
    iOS Liquid Glass v2:
    - Dark purple gradient background (matches rest of app)
    - Section labels: 11sp uppercase gray, 16dp left margin
    - Cards: dark frosted (#B2000000) rounded 16dp
    - 8dp gap between items within a group
    - 16dp gap between section groups
    - 24dp gap before primary CTA
    - CTA btn: iOS Blue (#007AFF) + white bold text  ← VIVID, no way to miss
    - Secondary: white text ghost button
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_gradient"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Handle pill -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.4"
        android:background="@color/white" />

    <!-- ══ SHEET TITLE ══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/dialog_export_to_gallery"
        android:textColor="@color/glass_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Export to Album" />

    <!-- ══ SECTION: FORMAT ══════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.1"
        android:text="@string/about_title_output"
        android:textAllCaps="true"
        android:textColor="@color/glass_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Format dropdown card -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuFormat"
        style="@style/SaveDialogExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glassmorphism_panel"
        android:hint="@string/dialog_save_config_format"
        app:boxBackgroundColor="@android:color/transparent"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:hintTextColor="@color/glass_text_hint">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/atvFormat"
            style="@style/SaveDialogAutoCompleteTextView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/ic_trans"
            android:hint="@string/dialog_save_config_format"
            android:inputType="none"
            android:labelFor="@id/menuFormat"
            android:minWidth="120dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/glass_text_primary"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══ SECTION: QUALITY ═════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/flQuality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/dialog_save_config_quality"
            android:textAllCaps="true"
            android:textColor="@color/glass_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQualityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/glass_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="80" />

    </FrameLayout>

    <!-- Slider in a dark frosted card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#B2000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="0.5dp">

        <com.google.android.material.slider.Slider
            android:id="@+id/slideQuality"
            style="@style/MySeekBarStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:focusable="false"
            android:stepSize="20"
            android:valueFrom="20.0"
            android:valueTo="100.0"
            app:labelBehavior="floating"
            tools:value="80" />

    </androidx.cardview.widget.CardView>

    <!-- ══ SECTION: EXPORT LIST ═════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/glass_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="EXPORT LIST 0/3" />

    <!-- Image preview grid -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#B2000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="0.5dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResult"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="none" />

    </androidx.cardview.widget.CardView>

    <!-- ══ PRIMARY CTA: iOS Blue "Export" button ════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#FF007AFF"
        android:fontFamily="sans-serif-medium"
        android:text="@string/dialog_export_to_gallery"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="45dp"
        app:elevation="8dp"
        app:rippleColor="#33FFFFFF"
        app:strokeWidth="0dp" />

    <!-- ══ SECONDARY: Open in gallery ══════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenGallery"
        style="@style/Widget.App.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:backgroundTint="@android:color/transparent"
        android:text="@string/dialog_open_in_gallery"
        android:textColor="@color/glass_text_secondary" />

</LinearLayout>
