<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentGallery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_glass_card"
            app:menu="@menu/top_app_bar"
            app:navigationIcon="@drawable/baseline_cancel_24"
            app:navigationIconTint="@color/glass_text_primary"
            app:title="@string/action_pick"
            app:titleTextColor="@color/glass_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.mckimquyen.watermark.ui.widget.MultiSelectRv
        android:id="@+id/rvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="126dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl" />

    <ImageView
        android:id="@+id/ivSlider"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_gallery_scroll_bar_anchor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl"
        app:layout_constraintVertical_bias="0"
        app:tint="@color/glass_text_primary"
        tools:ignore="ContentDescription,ImageContrastCheck"
        tools:value="340" />

    <!-- FAB with Ripple Effect -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Ripple Layer 1 (Outer) -->
        <View
            android:id="@+id/fabRipple1"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/fab_ripple_bg" />

        <!-- Ripple Layer 2 (Middle) -->
        <View
            android:id="@+id/fabRipple2"
            android:layout_width="180dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/fab_ripple_bg" />

        <!-- FAB Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#80FFFFFF"
            android:text="@string/tips_ok"
            android:textColor="@color/glass_text_primary"
            android:textSize="45sp"
            android:textStyle="bold"
            app:borderWidth="3dp"
            app:elevation="16dp"
            app:icon="@drawable/baseline_check_circle_outline_24"
            app:iconSize="45sp"
            app:iconTint="@color/glass_text_primary"
            app:rippleColor="@color/glass_ripple"
            app:shapeAppearance="@style/Widget.App.FloatingActionButton"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="3dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
