<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentGallery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="4dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_glass_card"
            android:elevation="4dp"
            app:menu="@menu/top_app_bar"
            app:navigationIcon="@drawable/baseline_cancel_24"
            app:navigationIconTint="@color/glass_text_primary"
            app:title="@string/action_pick"
            app:titleCentered="true"
            app:titleTextColor="@color/glass_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.mckimquyen.watermark.ui.widget.MultiSelectRv
        android:id="@+id/rvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="126dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl" />

    <androidx.cardview.widget.CardView
        android:id="@+id/sliderCard"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="12dp"
        app:cardBackgroundColor="#A0FFFFFF"
        app:cardCornerRadius="30dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl"
        app:layout_constraintVertical_bias="0"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/ivSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:src="@drawable/ic_gallery_scroll_bar_anchor"
            app:tint="@color/glass_text_primary"
            tools:ignore="ContentDescription,ImageContrastCheck"
            tools:value="340" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:backgroundTint="#90FFFFFF"
        android:text="@string/tips_ok"
        android:textColor="@color/glass_text_primary"
        android:textSize="45sp"
        android:textStyle="bold"
        app:borderWidth="3dp"
        app:elevation="16dp"
        app:icon="@drawable/baseline_check_circle_outline_24"
        app:iconSize="45sp"
        app:iconTint="@color/glass_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/glass_ripple"
        app:shapeAppearance="@style/Widget.App.FloatingActionButton"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
