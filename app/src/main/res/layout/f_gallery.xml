<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentGallery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ── Material 3 Top App Bar ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurface"
            android:elevation="0dp"
            app:menu="@menu/top_app_bar"
            app:navigationIcon="@drawable/baseline_cancel_24"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/action_pick"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Edge-to-edge photo grid ── -->
    <com.mckimquyen.watermark.ui.widget.MultiSelectRv
        android:id="@+id/rvContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="112dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl" />

    <!-- ── Scroll progress indicator (MaterialCardView) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sliderCard"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/abl"
        app:layout_constraintVertical_bias="0">

        <ImageView
            android:id="@+id/ivSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="11dp"
            android:src="@drawable/ic_gallery_scroll_bar_anchor"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription,ImageContrastCheck" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Selection count hint pill (animated M3 Badge) ── -->
    <TextView
        android:id="@+id/tvSelectionHint"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_m3_selection_badge"
        android:clipToOutline="true"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text=""
        android:textColor="?attr/colorOnSecondaryContainer"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="3 selected"
        tools:visibility="visible" />

    <!--
        ── Primary Confirm Extended FAB (Material You) ──
        Uses ?attr/colorPrimary and ?attr/colorOnPrimary
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="6dp"
        app:icon="@drawable/baseline_check_circle_outline_24"
        app:iconSize="24dp"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="?attr/colorOnPrimary"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
