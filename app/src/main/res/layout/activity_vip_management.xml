<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/glass_text_primary"
                app:title="@string/vip_title"
                app:titleTextColor="@color/glass_text_primary" />

            <!-- #1 Status header / hero card -->
            <LinearLayout
                android:id="@+id/statusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_vip_status_header_active"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerCrown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivCrown"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass_button"
                        android:padding="10dp"
                        android:src="@drawable/ic_workspace_premium"
                        app:tint="@color/glass_text_primary"
                        tools:ignore="ContentDescription" />
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVipStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="VIP Active" />

                    <TextView
                        android:id="@+id/tvVipEntry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp"
                        tools:text="First install gift" />

                    <!-- #3 Expiry row -->
                    <TextView
                        android:id="@+id/tvVipExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp"
                        tools:text="Expires Jun 15, 2026" />
                </LinearLayout>
            </LinearLayout>

            <!-- #4 progress + #5 countdown + #2 activation date -->
            <LinearLayout
                android:id="@+id/cardTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vip_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_time_left"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="12d 03h 24m 15s" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:indicatorColor="@color/vip_gold"
                    app:trackColor="@color/glass_overlay_light"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tvActivatedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="12sp"
                    tools:text="Activated: Jun 14, 2026 10:00" />
            </LinearLayout>

            <!-- #6 redeem key -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vip_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_redeem_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/vip_key_hint"
                    app:boxBackgroundColor="@color/glass_overlay_light"
                    app:boxStrokeColor="@color/glass_border"
                    app:endIconMode="clear_text"
                    app:hintTextColor="@color/glass_text_secondary"
                    app:startIconDrawable="@drawable/ic_confirmation_number"
                    app:startIconTint="@color/glass_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtVipKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:singleLine="true"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRedeemKey"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/vip_redeem_button"
                    app:icon="@drawable/ic_workspace_premium"
                    app:iconGravity="textStart"
                    app:iconTint="@color/glass_text_primary" />
            </LinearLayout>

            <!-- #7 watch rewarded -->
            <LinearLayout
                android:id="@+id/cardReward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vip_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_reward_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/vip_reward_desc"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchRewarded"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/vip_watch_rewarded"
                    app:icon="@drawable/ic_play_circle"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- #12 Active VIP card (single-entry) + revoke -->
            <LinearLayout
                android:id="@+id/cardActiveVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vip_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_active_card_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveEntryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="15sp"
                    tools:text="🎁 First install gift" />

                <TextView
                    android:id="@+id/tvActiveRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp"
                    tools:text="Expires Jun 15, 2026" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRevoke"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/vip_revoke_button"
                    android:textColor="@color/glass_text_primary"
                    app:icon="@drawable/ic_restore"
                    app:iconGravity="textStart"
                    app:iconTint="@color/glass_text_primary"
                    app:strokeColor="@color/glass_border" />
            </LinearLayout>

            <!-- #8-11 Buy VIP + #13 Restore (disabled placeholders) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vip_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_buy_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy30"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_30d_locked"
                    app:icon="@drawable/ic_card_giftcard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy90"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_90d_locked"
                    app:icon="@drawable/ic_card_giftcard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy1y"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_1y_locked"
                    app:icon="@drawable/ic_card_giftcard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuyLifetime"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_lifetime_locked"
                    app:icon="@drawable/ic_card_giftcard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestore"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/vip_restore_locked"
                    app:icon="@drawable/ic_restore" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/vip_privacy_footer"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Animation #5: confetti overlay -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/viewKonfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
