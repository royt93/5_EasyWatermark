<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Handle -->
    <View
        android:id="@+id/vHandle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:alpha="0.4"
        android:background="@drawable/bg_m3_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/position_anchor_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vHandle" />

    <!-- 9-grid anchor picker: 3 hàng LinearLayout weight=1 (GridLayout framework weight không ổn định) -->
    <LinearLayout
        android:id="@+id/glAnchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorTopLeft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_top_left"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_top_left"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorTopCenter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_top_center"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_top_center"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorTopRight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_top_right"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_top_right"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorCenterLeft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_center_left"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_center_left"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorCenter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_center"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_center"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorCenterRight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_center_right"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_center_right"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorBottomLeft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_bottom_left"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_bottom_left"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorBottomCenter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_bottom_center"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_bottom_center"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnchorBottomRight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/anchor_bottom_right"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_anchor_bottom_right"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOutlineVariant" />

        </LinearLayout>

    </LinearLayout>

    <!-- Margin label -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvMarginLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/position_anchor_margin"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvMarginValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glAnchor" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvMarginValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glAnchor"
        tools:text="5%" />

    <!-- Margin slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/slMargin"
        style="@style/MySeekBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/position_anchor_margin"
        android:focusable="true"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMarginLabel"
        tools:value="5" />

</androidx.constraintlayout.widget.ConstraintLayout>
