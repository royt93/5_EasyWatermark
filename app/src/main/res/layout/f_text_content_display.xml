<?xml version="1.0" encoding="utf-8"?>
<!--
    f_text_content_display — watermark text display bar (Content tab)
    Dark frosted pill — white text visible on dark background
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_floating_pill"
    android:clipToOutline="true"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <!-- Watermark icon -->
    <ImageView
        android:id="@+id/ivWatermarkIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:alpha="0.7"
        android:src="@drawable/ic_func_text"
        app:tint="@color/glass_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Text preview -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/etWaterText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:lines="1"
        android:singleLine="true"
        android:textColor="@color/glass_text_primary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/blinkCursor"
        app:layout_constraintStart_toEndOf="@id/ivWatermarkIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="DO NOT REDISTRIBUTE•" />

    <!-- Blinking cursor -->
    <com.mckimquyen.watermark.ui.widget.BlinkCursorView
        android:id="@+id/blinkCursor"
        android:layout_width="1.5dp"
        android:layout_height="18dp"
        android:layout_marginStart="2dp"
        android:background="@color/glass_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/etWaterText"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
