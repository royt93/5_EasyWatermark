<?xml version="1.0" encoding="utf-8"?>
<!--
    item_image_gallery — Grid tile with VIVID selection indicator
    iOS Liquid Glass v2:
    - Photo fills tile completely
    - Selection: photo scales down 85%, round corners appear
    - Check icon: 28dp vivid blue circle, always visible
    - Unselected: icon ghost (30% opacity, no circle bg)
-->
<com.mckimquyen.watermark.ui.widget.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1.5dp"
    android:background="#1A000000">

    <!-- Photo layer (scales on selection) -->
    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop" />

    <!-- Vivid selection checkmark — top-right corner -->
    <com.mckimquyen.watermark.ui.widget.RadioButton
        android:id="@+id/cbImage"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp" />

</com.mckimquyen.watermark.ui.widget.SquareFrameLayout>
